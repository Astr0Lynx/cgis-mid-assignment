# Copy to .env (git-ignored) and fill in YOUR Bhoonidhi account. Never commit the real file, never put it in an image.
BHOONIDHI_USER=
BHOONIDHI_PASSWORD=
# Turns on live mode in the service (fetch a scene from Bhoonidhi when none is on disk). Local use only.
BHOONIDHI_LIVE=1
# How the token is presented to /download: bearer (documented), query or token-header. Find out with
# python scripts/fetch_scene.py --bbox ... --date ... --probe-download-auth
# BHOONIDHI_DOWNLOAD_AUTH=bearer
